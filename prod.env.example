# =========================================================================
# LA Tracker - Konfigurasi PRODUKSI (Linux/VPS)
# Salin file ini menjadi ".env" lalu jalankan:  cp prod.env.example .env
# Docker Compose otomatis membaca file bernama ".env".
# =========================================================================

# --- Mode akses. PILIH SALAH SATU: ---
#
# (A) CLOUDFLARE TUNNEL (dipakai sekarang - VM di belakang NAT, port 80/443 tertutup)
#     SITE_ADDRESS=:80
#     PUBLIC_URL=https://app.bitech.co.id
#     TUNNEL_TOKEN=<token dari dashboard Cloudflare Zero Trust>
#     Jalankan dengan: docker compose -f docker-compose.prod.yml --profile tunnel up -d
#
# (B) DOMAIN LANGSUNG (butuh port 80/443 terbuka dari internet, HTTPS otomatis Let's Encrypt)
#     SITE_ADDRESS=app.bitech.co.id
#     PUBLIC_URL=https://app.bitech.co.id
#
# (C) IP SAJA (butuh port 80 terbuka, HTTP tanpa sertifikat)
#     SITE_ADDRESS=:80
#     PUBLIC_URL=http://154.17.167.145
#
DOMAIN=app.bitech.co.id
SITE_ADDRESS=:80
ACME_EMAIL=support@bitech.co.id
# URL publik lengkap (dipakai untuk CORS & link) - samakan dengan mode di atas
PUBLIC_URL=https://app.bitech.co.id
# (Opsional) Origin tambahan yang diizinkan CORS, dipisah koma.
# Catatan: semua domain *.preview.emergentagent.com (preview mobile/web Emergent)
# sudah otomatis diizinkan tanpa perlu diisi di sini.
# CORS_ORIGINS=https://app.bitech.co.id,https://origin-lain.com

# --- Cloudflare Tunnel (hanya mode A) ---
# Ambil dari: Cloudflare Zero Trust -> Networks -> Tunnels -> Create tunnel -> token
TUNNEL_TOKEN=isi-token-tunnel-disini

# --- Database MongoDB (dibuat otomatis di container mongo) ---
DB_NAME=la_tracker
MONGO_ROOT_USER=la_admin
MONGO_ROOT_PASS=Lintas4rt4

# --- Keamanan token login (minimal 32 karakter acak; buat cepat: openssl rand -hex 32) ---
JWT_SECRET=3c8550afb1486d6cf10b0947a33fc53591b33ffab29216696cbe0403a45a7f96

# --- Password akun bawaan (ganti setelah login pertama) ---
ADMIN_PASSWORD=admin123
OPERATOR_PASSWORD=oper123
GUEST_PASSWORD=guest
