# =========================================================================
# LA Tracker - Konfigurasi PRODUKSI (Linux/VPS)
# Salin file ini menjadi ".env" lalu isi nilainya:  cp prod.env.example .env
# Docker Compose otomatis membaca file bernama ".env".
# =========================================================================

# --- Domain & HTTPS (Caddy otomatis mengurus sertifikat Let's Encrypt) ---
DOMAIN=app.almar.co.id
ACME_EMAIL=admin@almar.co.id
# URL publik lengkap (dipakai untuk CORS & link) - harus https + domain di atas
PUBLIC_URL=https://app.almar.co.id

# --- Database MongoDB (dibuat otomatis di container mongo) ---
DB_NAME=la_tracker
MONGO_ROOT_USER=la_admin
# GANTI dengan password kuat & acak:
MONGO_ROOT_PASS=ubah-password-mongo-yang-kuat

# --- Keamanan token login (WAJIB diganti, minimal 32 karakter acak) ---
# Buat cepat:  openssl rand -hex 32
JWT_SECRET=ubah-dengan-teks-acak-panjang-min-32-karakter

# --- Password akun bawaan (ganti setelah login pertama) ---
ADMIN_PASSWORD=ubah-admin-password
OPERATOR_PASSWORD=ubah-operator-password
GUEST_PASSWORD=ubah-guest-password
