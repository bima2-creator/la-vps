{
	email {$ACME_EMAIL}
}

# SITE_ADDRESS menentukan mode:
#   - Domain  : SITE_ADDRESS=app.almar.co.id   -> HTTPS otomatis (Let's Encrypt)
#   - IP saja : SITE_ADDRESS=:80               -> HTTP biasa (tanpa sertifikat)
{$SITE_ADDRESS} {
	encode gzip

	# Semua request (web + /api) diteruskan ke container frontend (nginx),
	# yang menyajikan React dan mem-proxy /api ke backend:8001.
	reverse_proxy frontend:80

	# Naikkan batas upload untuk lampiran (SPK/Faktur/foto)
	request_body {
		max_size 50MB
	}
}
