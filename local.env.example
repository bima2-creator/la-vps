# LA Tracker — file konfigurasi lokal
# Skrip start.bat otomatis menyalin file ini menjadi local.env bila belum ada.
# Jangan commit file local.env ke Git.

# --- Akun login (login memakai USERNAME, bukan email) ---
# 3 akun tetap dibuat otomatis saat aplikasi pertama kali jalan:
#   admin    (peran: Administrator - akses penuh)
#   operator (peran: Operator      - input & edit data)
#   guest    (peran: Viewer        - hanya lihat)
# Ubah password di bawah bila perlu, lalu jalankan rebuild.bat.
ADMIN_PASSWORD=admin123
OPERATOR_PASSWORD=operator
GUEST_PASSWORD=guest

# Alamat email admin untuk notifikasi (opsional, tidak dipakai untuk login)
ADMIN_EMAIL=support@almar.co.id

# JWT signing secret (ganti ke string acak yang panjang untuk keamanan)
JWT_SECRET=change-this-to-a-long-random-string-please

# EMERGENT_LLM_KEY tidak diperlukan untuk mode lokal (STORAGE_MODE=local)
EMERGENT_LLM_KEY=
