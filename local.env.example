# LA Tracker — local environment file
# Copy dari local.env.example bila belum ada, edit sesuai kebutuhan.
# Jangan commit file ini ke Git.

# Admin akun default (dibuat otomatis saat pertama kali app dijalankan)
ADMIN_EMAIL=admin@la-tracker.com
ADMIN_PASSWORD=admin123

# JWT signing secret (ganti ke string random untuk produksi)
JWT_SECRET=change-this-to-a-long-random-string-please

# EMERGENT_LLM_KEY tidak diperlukan untuk mode lokal (STORAGE_MODE=local)
EMERGENT_LLM_KEY=
